// The Long View — Prisma schema (Phase 0)
//
// Phase 0 scope: entities only, matching section 25 of the spec.
// Field-level detail will grow as each phase is implemented — this is a
// starting shape, not a final one. See docs/decisions/ for why fields were
// added or changed as the product grows.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum ThesisStatus {
  DRAFT
  ACTIVE
  EVALUATED
}

enum ReactionType {
  LIKE
}

enum NotificationType {
  COMMENT
  REPLY
  REACTION
  COUNTER_THESIS
  HORIZON_APPROACHING
  THESIS_EVALUATED
  FOLLOWED_USER_PUBLISHED
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

model User {
  id           String   @id @default(cuid())
  // citext: compared case-insensitively by the database, so "Ana@x.com" and
  // "ana@x.com" are one account. The app also stores it lowercased
  // (normaliseEmail). See the case_insensitive_email migration.
  email        String   @unique @db.Citext
  username     String   @unique
  // Nullable: a Google-only account has no password to hash. Login must
  // check for null here before ever calling bcrypt.compare against it.
  passwordHash String?
  googleId     String?  @unique
  name         String
  bio          String?
  avatarUrl    String?
  // Every session token carries the value this had when it was issued;
  // raising it (logout) ends every session at once. See ADR 002.
  sessionVersion Int    @default(0)
  // The Terms version this person accepted, and when. Null: not yet
  // accepted (everyone before the agreement checkpoint).
  termsVersion    String?
  termsAcceptedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  theses         Thesis[]
  counterTheses  CounterThesis[]
  comments       Comment[]
  reactions      Reaction[]
  watchlists     Watchlist[]
  notifications  Notification[]
  reports        Report[]

  followedBy Follow[] @relation("followedBy")
  following  Follow[] @relation("following")

  @@index([username])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("following", fields: [followerId], references: [id])
  following User @relation("followedBy", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model Security {
  id            String   @id @default(cuid())
  ticker        String   @unique
  companyName   String
  sector        String?
  currentPrice  Decimal  @db.Decimal(12, 2)
  previousPrice Decimal? @db.Decimal(12, 2)
  updatedAt     DateTime @updatedAt

  theses     Thesis[]
  watchlists Watchlist[]
  prices     Price[]

  @@index([ticker])
}

model Price {
  id         String   @id @default(cuid())
  securityId String
  price      Decimal  @db.Decimal(12, 2)
  recordedAt DateTime @default(now())
  // The trading day NGX reports for this close. Null on rows saved before
  // it was recorded: their day isn't known for certain, so it isn't guessed.
  tradeDate  DateTime? @db.Date

  security Security @relation(fields: [securityId], references: [id])

  @@index([securityId, recordedAt])
  // One close per company per trading day. Postgres treats nulls as
  // distinct, so the older rows without a date never clash.
  @@unique([securityId, tradeDate])
}

model Thesis {
  id           String       @id @default(cuid())
  authorId     String
  securityId   String
  status       ThesisStatus @default(DRAFT)

  // Null until published — set from the security's live price at the
  // moment of publishing, never chosen by the author. See
  // docs/decisions/004-reference-price-at-publish-time.md.
  referencePrice Decimal? @db.Decimal(12, 2)
  targetPrice    Decimal  @db.Decimal(12, 2)
  conviction     Int
  horizonDays    Int

  statement            String
  bullCase             String?
  baseCase             String?
  bearCase             String?
  catalysts            String?
  risks                String?
  invalidationCondition String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author   User     @relation(fields: [authorId], references: [id])
  security Security @relation(fields: [securityId], references: [id])

  metrics        ThesisMetric[]
  counterTheses  CounterThesis[]
  comments       Comment[]
  reactions      Reaction[]
  outcome        ThesisOutcome?
  reports        Report[]

  @@index([securityId, status])
  @@index([authorId])
}

model ThesisMetric {
  id       String @id @default(cuid())
  thesisId String
  label    String
  value    String

  thesis Thesis @relation(fields: [thesisId], references: [id])

  @@index([thesisId])
}

model CounterThesis {
  id           String   @id @default(cuid())
  thesisId     String
  authorId     String

  targetPrice Decimal @db.Decimal(12, 2)
  conviction  Int
  horizonDays Int
  reasoning   String
  risks       String?
  assumptions String?

  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  thesis Thesis @relation(fields: [thesisId], references: [id])
  author User   @relation(fields: [authorId], references: [id])

  // One counter per person per original thesis — enforced here, not
  // just in the service layer, so a race between two near-simultaneous
  // requests from the same author can't both slip through.
  @@unique([thesisId, authorId])
  @@index([thesisId])
}

model Comment {
  id              String    @id @default(cuid())
  thesisId        String
  authorId        String
  parentCommentId String?
  body            String
  createdAt       DateTime  @default(now())

  thesis        Thesis    @relation(fields: [thesisId], references: [id])
  author        User      @relation(fields: [authorId], references: [id])
  parentComment Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies       Comment[] @relation("CommentReplies")

  @@index([thesisId])
}

model Reaction {
  id        String       @id @default(cuid())
  userId    String
  thesisId  String
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())

  user   User   @relation(fields: [userId], references: [id])
  thesis Thesis @relation(fields: [thesisId], references: [id])

  @@unique([userId, thesisId, type])
}

model Watchlist {
  id         String   @id @default(cuid())
  userId     String
  securityId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  security Security @relation(fields: [securityId], references: [id])

  @@unique([userId, securityId])
}

// Deterministic, idempotent evaluation record. One outcome per thesis —
// evaluation is a one-way transition (see docs/decisions for the race-
// condition and idempotency approach once Phase 6 lands).
model ThesisOutcome {
  id              String   @id @default(cuid())
  thesisId        String   @unique
  evaluationPrice Decimal  @db.Decimal(12, 2)
  actualReturn    Decimal  @db.Decimal(8, 4)
  targetReturn    Decimal  @db.Decimal(8, 4)
  outcomeScore    Decimal  @db.Decimal(8, 4)
  evaluatedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  thesis Thesis @relation(fields: [thesisId], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  payload   Json
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, read])
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  thesisId   String?
  reason     String
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())

  reporter User    @relation(fields: [reporterId], references: [id])
  thesis   Thesis? @relation(fields: [thesisId], references: [id])

  @@index([status])
}

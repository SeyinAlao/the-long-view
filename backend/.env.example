DATABASE_URL="postgresql://postgres:postgres@localhost:5432/the_long_view?schema=public"
# Only needed against a pooled database (e.g. Neon) - the Prisma CLI
# (migrations, generate) needs the direct, non-pooled connection.
# On a plain local Postgres with no pooler, leave this unset; it falls
# back to DATABASE_URL.
# DIRECT_URL="postgresql://user:pass@ep-example.aws.neon.tech/db?sslmode=require"
PORT=4000
JWT_SECRET="replace-with-a-long-random-value"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:3000"
GOOGLE_CLIENT_ID="replace-with-your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-your-google-oauth-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"
FRONTEND_URL="http://localhost:3000"
